#!/bin/bash
# Runs a resolution scan with the __scan_config.txt (and the other three
# settings files) in THIS folder, and archives it in
# runs/<date>_<time>_scan_<time|angle|position>/.
#
# Usage:   ./run_scan        (./run_scan --help for details)
#
# Made by setup_workdir.sh. The code and the Python found at that time are
# written below; MUONCOLLIDER_CODE=... or PYTHON=... override them.
here="$(cd "$(dirname "$0")" && pwd -P)"
if [ -z "${PYTHON:-}" ] && [ -x "@PYTHON@" ]; then export PYTHON="@PYTHON@"; fi
for code in "${MUONCOLLIDER_CODE:-}" "@CODE_DIR@" "$HOME/code/MuonCollider"; do
    if [ -n "$code" ] && [ -f "$code/run_scan.sh" ]; then
        [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && exec /bin/bash "$code/run_scan.sh" --help
        exec /bin/bash "$code/run_scan.sh" "$here"
    fi
done
echo "ERROR: cannot find the analysis code (looked in @CODE_DIR@ and ~/code/MuonCollider)." >&2
echo "If it is somewhere else, run:  MUONCOLLIDER_CODE=/path/to/MuonCollider ./run_scan" >&2
exit 1
